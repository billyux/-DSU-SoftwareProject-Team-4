# Turso(libSQL) 접속 정보
DATABASE_URL=sqlite+libsql://[YOUR-DATABASE]-[YOUR-ORG].turso.io/?authToken=[YOUR-AUTH-TOKEN]

# 공공데이터포털 인증키 (data.go.kr)
DATA_GO_KR_KEY=

# 카카오 REST API 키 (지오코딩용)
KAKAO_REST_KEY=

# 관리자 '즉시 데이터 최신화' 실행 암호 — 관리자 화면에 들어갈 때 입력하는 암호와 같아야 함
# (없으면 최신화 API가 503으로 거부됨. 배포 서버(Render) 환경변수에도 등록 필요)
ADMIN_PASSWORD=

# 프론트엔드 개발 서버 주소 (CORS 허용용)
FRONTEND_ORIGIN=http://localhost:5173
